<Window x:Class="MASA.ClipboardManager.UI.Views.QuickPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASA Quick Paste" Height="420" Width="480"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource BgDarkBrush}" 
            BorderBrush="{DynamicResource AccentBrush}" 
            BorderThickness="1.5" 
            CornerRadius="12" 
            Padding="14"
            Effect="{DynamicResource DropShadowEffect}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBox x:Name="QuickSearchBox" 
                         Style="{DynamicResource ModernSearchBoxStyle}"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Type to filter... (Press 1-9 to paste directly)" />
            </Grid>

            <!-- Item List -->
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding QuickItems}" 
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     Background="Transparent" 
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardDarkBrush}" 
                                BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,6" 
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding ContentType, Converter={StaticResource ContentTypeToIconConverter}}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Preview}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer Hint -->
            <Border Grid.Row="2" Padding="4,6,4,0" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="Enter: Paste • Esc: Close • ↑↓: Navigate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="MASA QuickPaste" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
