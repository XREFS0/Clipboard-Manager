<Window x:Class="MASA.ClipboardManager.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASA Settings" Height="620" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ Preferences &amp; Security Configuration" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- General Settings -->
                <Border Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="GENERAL &amp; STARTUP" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Start minimized to System Tray" IsChecked="{Binding StartMinimized}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Close window to System Tray instead of exiting" IsChecked="{Binding CloseToTray}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Enable background Clipboard Monitoring" IsChecked="{Binding ClipboardMonitoringEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- History & Retention -->
                <Border Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="HISTORY &amp; RETENTION" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Maximum History Items:" VerticalAlignment="Center" />
                            <TextBox Text="{Binding MaxHistoryItems, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Right" Style="{DynamicResource ModernSearchBoxStyle}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Auto-delete items older than (days):" VerticalAlignment="Center" />
                            <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Right" Style="{DynamicResource ModernSearchBoxStyle}" />
                        </Grid>
                        <CheckBox Content="Prevent duplicate clipboard entries (update timestamp only)" IsChecked="{Binding PreventDuplicates}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Keep Pinned and Favorite items when cleaning up" IsChecked="{Binding KeepFavoritesOnCleanup}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Privacy & Security -->
                <Border Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PRIVACY &amp; DPAPI ENCRYPTION" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10" />
                        <CheckBox Content="Do not store sensitive clipboard content (Passwords, API Keys, JWT, Cards)" IsChecked="{Binding DoNotStoreSensitiveData}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Encrypt stored clipboard data with Windows DPAPI" IsChecked="{Binding EnableEncryption}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <CheckBox Content="Auto-delete sensitive entries after temporary retention" IsChecked="{Binding AutoDeleteSensitiveData}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Sensitive Auto-Delete Delay (minutes):" VerticalAlignment="Center" />
                            <TextBox Text="{Binding SensitiveAutoDeleteMinutes, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Right" Style="{DynamicResource ModernSearchBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Application Exclusions -->
                <Border Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="APPLICATION EXCLUSIONS (Ignore copies from these apps)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewExcludedApp, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernSearchBoxStyle}" Tag="e.g. Keepass.exe, 1Password.exe" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Command="{Binding AddExcludedAppCommand}" Style="{DynamicResource GhostButtonStyle}"><TextBlock Text="+ Add" /></Button>
                        </Grid>

                        <ListBox ItemsSource="{Binding ExcludedApplications}" MaxHeight="120" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" Style="{DynamicResource GhostButtonStyle}" Padding="6,2"><TextBlock Text="✕" Foreground="{DynamicResource DangerBrush}" /></Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Shortcuts & Behavior -->
                <Border Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="SHORTCUTS &amp; QUICK PASTE" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Global Hotkey:" VerticalAlignment="Center" />
                            <TextBox Text="{Binding GlobalHotKey, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Right" Style="{DynamicResource ModernSearchBoxStyle}" />
                        </Grid>
                        <CheckBox Content="Simulate instant paste (Ctrl+V) when selecting from QuickPaste" IsChecked="{Binding PasteImmediatelyOnEnter}" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SaveSettingsCommand}" Style="{DynamicResource ModernButtonStyle}"><TextBlock Text="💾 Save Settings" /></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
