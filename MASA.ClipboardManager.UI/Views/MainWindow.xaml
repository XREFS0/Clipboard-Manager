<Window x:Class="MASA.ClipboardManager.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:MASA.ClipboardManager.UI.ViewModels"
        mc:Ignorable="d"
        Title="MASA Clipboard Manager" Height="720" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="64" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MASA Clipboard Manager" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Production-Ready • Encrypted • Privacy-First" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Input Box -->
                <Grid Grid.Column="1" Margin="30,0" MaxWidth="450">
                    <TextBox Style="{DynamicResource ModernSearchBoxStyle}" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search clipboard history (text, URLs, code, files)..." />
                </Grid>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Privacy Mode Toggle Button -->
                    <Button Command="{Binding TogglePrivacyModeCommand}" 
                            Style="{DynamicResource GhostButtonStyle}" 
                            Margin="0,0,8,0"
                            ToolTip="Toggle Privacy Mode (Stops recording clipboard)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️ " />
                            <TextBlock Text="Privacy Mode" />
                        </StackPanel>
                    </Button>

                    <!-- Pause/Resume Monitoring -->
                    <Button Command="{Binding ToggleMonitoringCommand}" 
                            Style="{DynamicResource GhostButtonStyle}" 
                            Margin="0,0,8,0"
                            ToolTip="Pause or Resume Clipboard Monitoring">
                        <TextBlock Text="⏸️ Pause" />
                    </Button>

                    <!-- Dev Tools Workbench Button -->
                    <Button x:Name="BtnOpenDevTools" Click="OpenDevTools_Click" 
                            Style="{DynamicResource GhostButtonStyle}" 
                            Margin="0,0,8,0"
                            ToolTip="Developer Tools (JSON, Base64, URL, HTML)">
                        <TextBlock Text="⚡ DevTools" />
                    </Button>

                    <!-- Settings Window Button -->
                    <Button x:Name="BtnOpenSettings" Click="OpenSettings_Click" 
                            Style="{DynamicResource ModernButtonStyle}"
                            ToolTip="Open Settings">
                        <TextBlock Text="⚙ Settings" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body (Sidebar + List + Preview Pane) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Collections Sidebar -->
                <ColumnDefinition Width="220" />
                <!-- Filtered Clipboard List -->
                <ColumnDefinition Width="380" />
                <!-- Item Preview & Quick Actions -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Sidebar: Categories & Collections -->
            <Border Grid.Column="0" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,10" />

                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="All" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="📜 All Items" />
                        </Button>
                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="Pinned" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="📌 Pinned Items" />
                        </Button>
                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="Favorites" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="⭐ Favorites" />
                        </Button>

                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,12" />

                        <TextBlock Text="CONTENT TYPES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,10" />

                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="Text" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="📝 Plain Text" />
                        </Button>
                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="Code" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="💻 Code Snippets" />
                        </Button>
                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="URL" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="🔗 URLs / Links" />
                        </Button>
                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="Image" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="🖼 Images" />
                        </Button>
                        <Button Command="{Binding FilterByTypeCommand}" CommandParameter="File" Style="{DynamicResource GhostButtonStyle}" HorizontalContentAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="📄 Files &amp; Folders" />
                        </Button>

                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,12" />

                        <Grid Margin="6,0,0,10">
                            <TextBlock Text="COLLECTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.FilterByTypeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Name}"
                                            Style="{DynamicResource GhostButtonStyle}" 
                                            HorizontalContentAlignment="Left" 
                                            Margin="0,0,0,4">
                                        <Grid Width="170">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ItemCount}" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Clear All History Action -->
                        <Button Command="{Binding ClearAllCommand}" Style="{DynamicResource GhostButtonStyle}" Margin="0,20,0,0" Foreground="{DynamicResource DangerBrush}">
                            <TextBlock Text="🗑️ Clear History" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2. Middle Column: Virtualized Clipboard History List -->
            <Border Grid.Column="1" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="12">
                <ListBox ItemsSource="{Binding FilteredItems}" 
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Background="Transparent" 
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardDarkBrush}" 
                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="12" 
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon + Type + Time + Pin -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ContentType, Converter={StaticResource ContentTypeToIconConverter}}" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding ContentType}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding IsPinned, Converter={StaticResource BooleanToPinIconConverter}}" FontSize="12" Margin="0,0,8,0" Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding IsFavorite, Converter={StaticResource BooleanToFavoriteStarConverter}}" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,8,0" Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Middle Row: Preview Text or Image Thumbnail -->
                                    <TextBlock Grid.Row="1" Text="{Binding Preview}" 
                                               TextTrimming="CharacterEllipsis" 
                                               MaxHeight="42" 
                                               FontSize="13" 
                                               FontWeight="Normal" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               TextWrapping="Wrap" />

                                    <!-- Bottom Row: Metadata & Size -->
                                    <Grid Grid.Row="2" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceProcessName}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding SizeInBytes, Converter={StaticResource FileSizeConverter}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 3. Right Column: Preview & Detailed Actions -->
            <Border Grid.Column="2" Background="{DynamicResource CardDarkBrush}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Item Header & Buttons -->
                        <RowDefinition Height="Auto" />
                        <!-- Content Preview Area -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Action Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header with Title & Pin/Fav buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedItem.ContentType, Converter={StaticResource ContentTypeToIconConverter}}" FontSize="22" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SelectedItem.ContentType}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding TogglePinCommand}" Style="{DynamicResource GhostButtonStyle}" Margin="0,0,8,0" ToolTip="Pin to top">
                                <TextBlock Text="{Binding SelectedItem.IsPinned, Converter={StaticResource BooleanToPinIconConverter}}" />
                            </Button>
                            <Button Command="{Binding ToggleFavoriteCommand}" Style="{DynamicResource GhostButtonStyle}" Margin="0,0,8,0" ToolTip="Toggle Favorite">
                                <TextBlock Text="{Binding SelectedItem.IsFavorite, Converter={StaticResource BooleanToFavoriteStarConverter}}" Foreground="{DynamicResource WarningBrush}" />
                            </Button>
                            <Button Command="{Binding DeleteItemCommand}" Style="{DynamicResource GhostButtonStyle}" Foreground="{DynamicResource DangerBrush}" ToolTip="Delete Item">
                                <TextBlock Text="🗑️ Delete" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Content Details Display -->
                    <Border Grid.Row="1" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- If Image Type -->
                                <Image Source="{Binding SelectedItem.ImageStoragePath, Converter={StaticResource ImagePathToBitmapConverter}}" 
                                       MaxHeight="350" HorizontalAlignment="Center" Margin="0,0,0,12" />

                                <!-- Text Content Box -->
                                <TextBox Text="{Binding SelectedItem.PlainTextContent, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         TextWrapping="Wrap" 
                                         Background="Transparent" 
                                         Foreground="{DynamicResource TextPrimaryBrush}" 
                                         BorderThickness="0" 
                                         FontSize="13" 
                                         FontFamily="Cascadia Code, Consolas, Courier New" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Bottom Actions (Copy, Paste, Edit, Open) -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding CopyItemCommand}" Style="{DynamicResource ModernButtonStyle}" Margin="0,0,10,0">
                                <TextBlock Text="📋 Copy Again" />
                            </Button>
                            <Button Command="{Binding PasteItemCommand}" Style="{DynamicResource ModernButtonStyle}" Margin="0,0,10,0">
                                <TextBlock Text="🚀 Quick Paste" />
                            </Button>
                            <Button x:Name="BtnEditText" Click="EditText_Click" Style="{DynamicResource GhostButtonStyle}" Margin="0,0,10,0">
                                <TextBlock Text="✏️ Edit Text" />
                            </Button>
                            <Button Command="{Binding OpenUrlCommand}" Style="{DynamicResource GhostButtonStyle}" Margin="0,0,10,0">
                                <TextBlock Text="🌐 Open Link" />
                            </Button>
                            <Button Command="{Binding OpenFileCommand}" Style="{DynamicResource GhostButtonStyle}">
                                <TextBlock Text="📂 Open File" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Shortcut: Ctrl+Shift+V | Privacy: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding IsPrivacyMode}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
